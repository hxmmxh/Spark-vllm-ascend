#include "head_q6.h"
using namespace AscendC;
#ifndef __DAV_C310_CUBE__
template<bool Decode> __aicore__ inline void run_impl(GM_ADDR xg,GM_ADDR wg,GM_ADDR yg,int rows){
 constexpr int K=2560,M=8,BY=22400;int core=GetBlockIdx(),nt=rows/M,start=nt*core/56,end=nt*(core+1)/56,tiles=end-start;
 TPipe pipe;TBuf<QuePosition::VECCALC>wb,xb,tb,yb;
 pipe.InitBuffer(wb,65536);pipe.InitBuffer(xb,15360);pipe.InitBuffer(tb,2048);pipe.InitBuffer(yb,Decode?40960:((rows/8+55)/56)*32);
 auto w=wb.Get<uint8_t>();auto x=xb.Get<bfloat16_t>();auto xf=xb.Get<float>()[1280];auto tmp=tb.Get<float>();auto y=yb.Get<bfloat16_t>();
 GlobalTensor<bfloat16_t>xx,yy;GlobalTensor<uint8_t>ww;xx.SetGlobalBuffer((__gm__ bfloat16_t*)xg);yy.SetGlobalBuffer((__gm__ bfloat16_t*)yg);ww.SetGlobalBuffer(wg);ww.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
 if constexpr(!Decode){DataCopy(x,xx,2560);SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);HeadQ6::expand((__ubuf__ bfloat16_t*)x.GetPhyAddr(),(__ubuf__ float*)xf.GetPhyAddr());}
 if(tiles==0)return;
 DataCopy(w,ww[(int64_t)start*BY],BY);SetFlag<HardEvent::MTE2_V>(4);
 for(int i=0;i<tiles;i++){
  int slot=i&1,other=slot^1;if(i>0)WaitFlag<HardEvent::V_MTE2>(4+other);
  if(i+1<tiles){DataCopy(w[other*32768],ww[(int64_t)(start+i+1)*BY],BY);SetFlag<HardEvent::MTE2_V>(4+other);}
  WaitFlag<HardEvent::MTE2_V>(4+slot);
  if constexpr(Decode){
   if(i>0){SetFlag<HardEvent::MTE3_V>(1);WaitFlag<HardEvent::MTE3_V>(1);}
   HeadQ6::compute<false>((__ubuf__ float*)xf.GetPhyAddr(),(__ubuf__ uint8_t*)w[slot*32768].GetPhyAddr(),(__ubuf__ float*)tmp.GetPhyAddr(),(__ubuf__ bfloat16_t*)y.GetPhyAddr());
   SetFlag<HardEvent::V_MTE3>(1);WaitFlag<HardEvent::V_MTE3>(1);DataCopy(yy[(int64_t)(start+i)*M*K],y,M*K);
  }else HeadQ6::compute<true>((__ubuf__ float*)xf.GetPhyAddr(),(__ubuf__ uint8_t*)w[slot*32768].GetPhyAddr(),(__ubuf__ float*)tmp.GetPhyAddr(),(__ubuf__ bfloat16_t*)y[i*16].GetPhyAddr());
  SetFlag<HardEvent::V_MTE2>(4+slot);
 }
 WaitFlag<HardEvent::V_MTE2>(4+((tiles-1)&1));
 if constexpr(!Decode){SetFlag<HardEvent::V_MTE3>(2);WaitFlag<HardEvent::V_MTE3>(2);DataCopyExtParams cp{(uint16_t)tiles,16,0,0,0};DataCopyPad(yy[start*M],y,cp);}
 PipeBarrier<PIPE_ALL>();
}
#endif
extern "C" __global__ __aicore__ void head_q6s(GM_ADDR x,GM_ADDR w,GM_ADDR y,int rows,int decode){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);InitSocState();
#ifndef __DAV_C310_CUBE__
 if(decode)run_impl<true>(x,w,y,rows);else run_impl<false>(x,w,y,rows);
#endif
}
extern "C" void launch_head_q6s(void*s,uint8_t*x,uint8_t*w,uint8_t*y,int rows,int decode){head_q6s<<<28,nullptr,s>>>(x,w,y,rows,decode);}
